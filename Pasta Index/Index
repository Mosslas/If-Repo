<!doctype html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Trabalho</title>
	<link rel="stylesheet" href="style.css">
</head>
<body>
	<header>
		<h1>Pagina Web</h1>
		<p>Boas vindas ao meu site do Trabalho</p>
		<p>Feito por Matheus Silva Guida</p>

		<nav>
			<a href="index.html">Início</a>
			<a href="#interesses">Interesses</a>
			<a href="#contato">Contato</a>
			<a href="sobre.html">Sobre</a>
		</nav>
	</header>

	<main>
		<section class="conteudo" id="apresentacao">
			<img class="foto" src="foto.png" alt="Foto">
			<p>Estudante do curso Técnico em Informática para Internet.</p>
		</section>

		<section class="conteudo" id="interesses">
			<h2>Interesses</h2>

			<ul class="interesses">
				<li>Desenho</li>
				<li>Jogos</li>
				<li>Programação web</li>
			</ul>
		</section>

		<section class="conteudo" id="contato">
			<h2>Entre em contato</h2>

			<form action="#" method="post">
				<fieldset class="dados">
					<legend>Seus dados</legend>

					<label for="nome">Nome</label>
					<input type="text" id="nome" name="nome" required>

					<label for="email">E-mail</label>
					<input type="email" id="email" name="email" required>
				</fieldset>

				<fieldset class="recado">
					<legend>Sua mensagem</legend>

					<label for="assunto">Assunto</label>
					<input type="text" id="assunto" name="assunto">

					<label for="mensagem">Mensagem</label>
					<textarea id="mensagem" name="mensagem" required></textarea>
				</fieldset>

				<div class="botoes">
					<button type="submit">Enviar</button>
					<button type="reset">Limpar</button>
				</div>
			</form>
		</section>
	</main>

	<footer>
		<p>&copy; 2026 Matheus Silva Guida</p>
	</footer>
</body>
</html>
